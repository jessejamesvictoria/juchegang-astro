---
import { ViewTransitions } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
  description?: string
  ogImage?: string
}

const {
  title,
  description = 'The die is cast. Unity and AI for Korea and Canada. JucheGang connects diaspora communities, strategic intelligence, and sovereign technology across the Pacific corridor. 주사위는 던져졌다.',
  ogImage = '/brand/og-image.jpg',
} = Astro.props

const siteUrl = 'https://juchegang.ca'
const fullTitle = `${title} | JucheGang`
const ogImageUrl = `${siteUrl}${ogImage}`
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#050505" />
  <meta name="author" content="JucheGang / JPanda Network" />
  <link rel="canonical" href={siteUrl} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/brand/icon-192.png" type="image/png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/brand/icon-192.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:site_name" content="JucheGang" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="JucheGang - The die is cast. Unity and AI for Korea and Canada." />
  <meta property="og:url" content={siteUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_CA" />
  <meta property="og:locale:alternate" content="ko_KR" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content="JucheGang - The die is cast" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+KR:wght@400;500&display=swap" rel="stylesheet" />

  <title>{fullTitle}</title>
  <ViewTransitions />
</head>
<body>
  <div class="noise-overlay" aria-hidden="true"></div>
  <slot />

  <script>
    function initReveal() {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add('visible')
          })
        },
        { threshold: 0.08, rootMargin: '0px 0px -32px 0px' }
      )
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el))
    }
    initReveal()
    document.addEventListener('astro:page-load', initReveal)
  </script>
</body>
</html>