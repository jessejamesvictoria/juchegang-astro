---
---

<section id="brand" class="border-b-2 border-[var(--ink)]">
  <div class="container-app">
    <div class="border-x-2 border-[var(--ink)]">
      <div class="grid lg:grid-cols-12 border-b-2 border-[var(--ink)]">
        <div class="lg:col-span-7 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
          <h2 class="text-section frame-angle">Brand kit</h2>
          <p class="font-ko text-sm text-[var(--muted)] mt-3">브랜드 키트</p>
        </div>
        <div class="lg:col-span-5 cell flex items-end reveal reveal-delay-1">
          <p class="text-sm text-body text-pretty bilingual">
            Swiss Industrial Print. Dice-cast mark, hazard telemetry, blueprint substrate. Paper, ink, one accent.
            <span class="ko block">스위스 산업 인쇄. 주사위 표식, 경고 텔레메트리, 청사진 기반.</span>
          </p>
        </div>
      </div>

      <figure class="reveal reveal-delay-2 border-b-2 border-[var(--ink)]">
        <img
          src="/brand/brand-kit-board.jpg"
          alt="JucheGang brand guidelines board showing logo, colors, typography, and the die is cast tagline"
          width="1600"
          height="1200"
          loading="lazy"
          class="w-full h-auto block"
        />
        <figcaption class="cell py-3 border-t-2 border-[var(--ink)] flex flex-wrap gap-6">
          <span class="font-mono-ui text-[0.6rem]">Paper #F4F4F0</span>
          <span class="font-mono-ui text-[0.6rem]">Ink #050505</span>
          <span class="font-mono-ui text-[0.6rem] text-[var(--hazard)]">Hazard #E61919</span>
          <a href="/brand/BRAND.md" class="link-text">Full spec</a>
        </figcaption>
      </figure>

      <div class="blueprint-grid grid-cols-2 md:grid-cols-4 reveal reveal-delay-3">
        <div class="cell flex flex-col items-center justify-center gap-3 min-h-[140px]">
          <img src="/favicon.svg" alt="" width="48" height="48" aria-hidden="true" />
          <span class="font-mono-ui text-[0.6rem]">Favicon</span>
        </div>
        <div class="cell flex flex-col items-center justify-center gap-3 min-h-[140px]">
          <img src="/brand/mark.svg" alt="" width="48" height="48" aria-hidden="true" />
          <span class="font-mono-ui text-[0.6rem]">Mark</span>
        </div>
        <div class="cell flex flex-col items-center justify-center gap-3 min-h-[140px]">
          <img src="/brand/icon-192.png" alt="" width="48" height="48" aria-hidden="true" />
          <span class="font-mono-ui text-[0.6rem]">Icon 192</span>
        </div>
        <div class="cell flex flex-col items-center justify-center gap-3 min-h-[140px]">
          <img src="/brand/og-image.jpg" alt="" width="80" height="45" class="border border-[var(--ink)]" aria-hidden="true" />
          <span class="font-mono-ui text-[0.6rem]">OG Image</span>
        </div>
      </div>
    </div>
  </div>
</section>