---
import { unityThesis, yiSunSin, currentPanels, currentResources } from '../../data/current'
---

<section id="current" class="border-b-2 border-[var(--ink)]">
  <div class="hazard-stripe" aria-hidden="true"></div>
  <div class="container-app">
    <div class="border-x-2 border-[var(--ink)] blueprint-canvas relative">
      <span class="registration-mark tl" aria-hidden="true"></span>
      <span class="registration-mark tr" aria-hidden="true"></span>

      <!-- Unity thesis -->
      <div class="grid lg:grid-cols-12 border-b-2 border-[var(--ink)]">
        <div class="lg:col-span-7 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
          <samp class="font-mono-ui text-[var(--hazard)] block mb-4">The Current · 주체강 · OR-7394</samp>
          <h2 class="text-macro frame-bracket text-balance">{unityThesis.headline}</h2>
          <p class="font-ko text-sm text-[var(--muted)] mt-3">{unityThesis.headlineKo}</p>
        </div>
        <div class="lg:col-span-5 cell flex flex-col justify-between reveal reveal-delay-1">
          <p class="text-sm text-body bilingual text-pretty">
            {unityThesis.subhead}
            <span class="ko block">{unityThesis.subheadKo}</span>
          </p>
          <p class="text-xs text-[var(--muted)] bilingual text-pretty mt-6 lg:mt-0">
            {unityThesis.context}
            <span class="ko block">{unityThesis.contextKo}</span>
          </p>
        </div>
      </div>

      <!-- Editorial panels -->
      {currentPanels.map((panel, panelIndex) => (
        <article
          id={panel.id}
          class:list={[
            'border-b-2 border-[var(--ink)]',
            panelIndex === currentPanels.length - 1 && 'border-b-0',
          ]}
        >
          <div class="compartment-header">
            <samp class="font-mono-ui text-[var(--hazard)]">
              {panel.roman} · {panel.hanja} · {panel.titleKo}
            </samp>
          </div>

          <div class="grid lg:grid-cols-12">
            <div class:list={[
              'lg:col-span-4 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal',
              panelIndex % 2 === 1 && 'lg:order-2 lg:border-r-0 lg:border-l-2',
            ]}>
              <h3 class="text-section frame-bracket">{panel.title}</h3>
              <p class="font-ko text-sm text-[var(--muted)] mt-2">{panel.titleKo}</p>
              <p class="text-sm text-body text-pretty mt-6 font-medium">{panel.lead}</p>
              <p class="font-ko text-xs text-[var(--muted)] mt-2">{panel.leadKo}</p>
            </div>

            <div class:list={[
              'lg:col-span-5 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal reveal-delay-1',
              panelIndex % 2 === 1 && 'lg:order-1 lg:border-r-2 lg:border-l-0',
            ]}>
              <p class="text-sm text-body bilingual text-pretty">
                {panel.body}
                <span class="ko block">{panel.bodyKo}</span>
              </p>
              {panel.quote && (
                <blockquote class="mt-6 border-l-4 border-[var(--hazard)] pl-4">
                  <p class="text-xs italic text-pretty">"{panel.quote.text}"</p>
                  <cite class="font-mono-ui text-[0.55rem] text-[var(--muted)] block mt-2 not-italic">
                    {panel.quote.attribution}
                  </cite>
                </blockquote>
              )}
            </div>

            <div class:list={[
              'lg:col-span-3 blueprint-grid grid-cols-1 reveal reveal-delay-2',
              panelIndex % 2 === 1 && 'lg:order-3',
            ]}>
              {panel.stats.map(stat => (
                <div class="cell">
                  <data value={stat.value} class="stat-num block text-[var(--ink)] text-2xl">{stat.value}</data>
                  <p class="font-mono-ui mt-2 text-[0.6rem]">{stat.label}</p>
                  {stat.detail && <p class="text-xs text-[var(--muted)] mt-1">{stat.detail}</p>}
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}

      <!-- Yi Sun-sin inheritance -->
      <div class="border-t-2 border-[var(--ink)]">
        <div class="compartment-header">
          <samp class="font-mono-ui text-[var(--hazard)]">Inheritance · 유산 · 이순신</samp>
        </div>
        <div class="grid lg:grid-cols-12">
          <div class="lg:col-span-4 relative min-h-[280px] halftone-img border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
            <span class="crosshair-mark tl" aria-hidden="true">+</span>
            <span class="crosshair-mark br" aria-hidden="true">+</span>
            <img
              src={yiSunSin.image}
              alt={yiSunSin.imageAlt}
              width="600"
              height="750"
              loading="lazy"
              class="absolute inset-0 w-full h-full"
            />
          </div>

          <div class="lg:col-span-4 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal reveal-delay-1">
            <h3 class="font-macro text-xl">{yiSunSin.name}</h3>
            <p class="font-ko text-sm text-[var(--hazard)] mt-1">{yiSunSin.nameKo} · {yiSunSin.years}</p>
            <dl class="mt-6 space-y-0 border-2 border-[var(--ink)]">
              <div class="grid grid-cols-[auto_1fr] gap-3 px-3 py-2 border-b-2 border-[var(--ink)]">
                <dt class="font-mono-ui text-[var(--muted)]">Record</dt>
                <dd class="font-mono-ui text-[0.6rem]">{yiSunSin.record}</dd>
              </div>
              <div class="grid grid-cols-[auto_1fr] gap-3 px-3 py-2 border-b-2 border-[var(--ink)]">
                <dt class="font-mono-ui text-[var(--muted)]">명량</dt>
                <dd class="font-mono-ui text-[0.6rem]">{yiSunSin.myeongnyang}</dd>
              </div>
              <div class="grid grid-cols-[auto_1fr] gap-3 px-3 py-2">
                <dt class="font-mono-ui text-[var(--muted)]">Model</dt>
                <dd class="font-mono-ui text-[0.6rem] text-[var(--hazard)]">{yiSunSin.funding}</dd>
              </div>
            </dl>
            <p class="text-sm text-body bilingual text-pretty mt-6">
              {yiSunSin.unity}
              <span class="ko block">{yiSunSin.unityKo}</span>
            </p>
          </div>

          <div class="lg:col-span-4 grid grid-rows-2 reveal reveal-delay-2">
            <figure class="relative halftone-img min-h-[200px] border-b-2 border-[var(--ink)]">
              <img
                src={yiSunSin.turtleImage}
                alt={yiSunSin.turtleAlt}
                width="500"
                height="400"
                loading="lazy"
                class="absolute inset-0 w-full h-full"
              />
              <figcaption class="absolute bottom-0 left-0 right-0 px-3 py-2 bg-[var(--paper)] border-t border-[var(--ink)]">
                <samp class="tag-hazard text-[0.55rem]">Geobukseon</samp>
                <p class="font-mono-ui text-[0.55rem] mt-1">Turtle ship · 1795</p>
              </figcaption>
            </figure>
            <figure class="relative halftone-img min-h-[200px]">
              <img
                src={yiSunSin.manuscript}
                alt={yiSunSin.manuscriptAlt}
                width="500"
                height="400"
                loading="lazy"
                class="absolute inset-0 w-full h-full"
              />
              <figcaption class="absolute bottom-0 left-0 right-0 px-3 py-2 bg-[var(--paper)] border-t border-[var(--ink)]">
                <samp class="tag-ink text-[0.55rem]">Archive</samp>
                <p class="font-mono-ui text-[0.55rem] mt-1">Nanjung Ilgi · 1592–1598</p>
              </figcaption>
            </figure>
          </div>
        </div>

        <div class="grid lg:grid-cols-2 border-t-2 border-[var(--ink)]">
          <div class="cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
            <p class="text-sm text-body bilingual text-pretty">
              {yiSunSin.turtleShip}
              <span class="ko block">{yiSunSin.turtleShipKo}</span>
            </p>
          </div>
          <div class="cell reveal reveal-delay-1">
            <p class="text-sm text-body bilingual text-pretty">
              {yiSunSin.humanity}
              <span class="ko block">{yiSunSin.humanityKo}</span>
            </p>
          </div>
        </div>
      </div>

      <!-- Coda: resources -->
      <div class="border-t-2 border-[var(--ink)]">
        <div class="compartment-header">
          <samp class="font-mono-ui text-[var(--hazard)]">Coda · 산술 · Navigate the Current</samp>
        </div>
        <div class="grid lg:grid-cols-12 border-b-2 border-[var(--ink)]">
          <div class="lg:col-span-5 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
            <h3 class="text-section">Pride is the why. This is the how much.</h3>
            <p class="font-ko text-sm text-[var(--muted)] mt-2">자부심이 이유라면, 이것이 규모입니다.</p>
            <p class="text-sm text-body bilingual text-pretty mt-4">
              One page moves the heart; the spreadsheet closes the deal. Diplomats and sovereign-fund desks act on figures with receipts.
              <span class="ko block">한 페이지는 마음을 움직이고, 스프레드시트가 거래를 닫습니다. 외교관과 주권펀드는 영수증 있는 숫자로 움직입니다.</span>
            </p>
            <div class="flex flex-col sm:flex-row gap-0 mt-6 border-2 border-[var(--ink)] w-fit">
              <a href="/report-7394-k" class="btn-primary border-0">Report 7394-K &gt;&gt;&gt;</a>
              <a href="/the-current" class="btn-hazard border-0 border-l-2 border-[var(--ink)]">The Current</a>
            </div>
          </div>
          <div class="lg:col-span-7 blueprint-grid grid-cols-1 sm:grid-cols-2 reveal reveal-delay-1">
            {currentResources.map(res => (
              <a
                href={res.href}
                class="network-link cell min-h-[140px]"
                target={res.href.startsWith('http') ? '_blank' : undefined}
                rel={res.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                <div class="flex items-start justify-between gap-3">
                  <code class="font-mono-ui text-[0.6rem]">{res.title}</code>
                  <samp class="tag-hazard">{res.type}</samp>
                </div>
                <p class="font-ko text-xs text-[var(--muted)] mt-1">{res.titleKo}</p>
                <p class="text-xs text-[var(--muted)] mt-2">{res.desc}</p>
                <span class="link-arrow link-cta text-[var(--muted)] text-[0.6rem]">&gt;&gt;&gt;</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <span class="registration-mark bl" aria-hidden="true"></span>
      <span class="registration-mark br" aria-hidden="true"></span>
    </div>
  </div>
</section>