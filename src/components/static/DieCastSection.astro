---
import { dieCast } from '../../data/manifesto'
import SectionEyebrow from './SectionEyebrow.astro'
---

<section id="manifesto" class="border-b-2 border-[var(--ink)]">
  <div class="hazard-stripe" aria-hidden="true"></div>
  <div class="container-app">
    <div class="grid lg:grid-cols-12 border-x-2 border-[var(--ink)] blueprint-canvas relative">
      <span class="registration-mark tl" aria-hidden="true"></span>
      <span class="registration-mark br" aria-hidden="true"></span>

      <div class="lg:col-span-5 cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
        <SectionEyebrow label={`${dieCast.date} / Rubicon`} labelKo="루비콘" code="MAN-01" />
        <h2 class="text-macro text-balance frame-bracket">{dieCast.english}</h2>
        <p class="font-macro text-xl text-[var(--hazard)] mt-4">{dieCast.latin}</p>
        <p class="font-ko text-lg text-[var(--ink)] mt-3">{dieCast.korean}</p>
        <p class="font-ko text-sm text-[var(--muted)] mt-2">{dieCast.idiomKo}</p>
      </div>

      <div class="lg:col-span-4 relative min-h-[320px] halftone-img border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal reveal-delay-1">
        <span class="crosshair-mark tl" aria-hidden="true">+</span>
        <span class="crosshair-mark br" aria-hidden="true">+</span>
        <img
          src="/images/northof38.jpg"
          alt="Korean peninsula landscape north of the 38th parallel"
          width="700"
          height="900"
          loading="lazy"
          class="absolute inset-0 w-full h-full"
        />
      </div>

      <div class="lg:col-span-3 cell reveal reveal-delay-2 flex flex-col justify-between">
        <div>
          <p class="text-sm text-body text-pretty bilingual">
            {dieCast.meaning}
            <span class="ko block">{dieCast.meaningKo}</span>
          </p>
        </div>
        <dl class="mt-8 space-y-0 border-2 border-[var(--ink)]">
          <div class="grid grid-cols-[auto_1fr] gap-3 px-3 py-2 border-b-2 border-[var(--ink)]">
            <dt class="font-mono-ui text-[var(--muted)]">Origin</dt>
            <dd class="font-mono-ui text-[0.6rem]">{dieCast.event}</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-3 px-3 py-2 border-b-2 border-[var(--ink)]">
            <dt class="font-mono-ui text-[var(--muted)]">한국어</dt>
            <dd class="font-ko text-xs">{dieCast.eventKo}</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-3 px-3 py-2">
            <dt class="font-mono-ui text-[var(--muted)]">Status</dt>
            <dd class="font-mono-ui text-[var(--hazard)]">Irreversible</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>