---
/**
 * Footer Component - Layer 0 (Static HTML)
 *
 * Static footer with no JavaScript.
 * Links and content are pre-rendered.
 */

const currentYear = new Date().getFullYear()

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/#laws', label: 'The 48 Laws' },
  { href: '/briefings', label: 'Briefings' },
  { href: '/truth-project', label: 'Truth Project' },
  { href: '/mission', label: 'Mission' },
  { href: '/contact', label: 'Contact' },
]

const socialLinks = [
  { href: 'https://instagram.com/jpandajames39', label: 'Instagram', icon: 'instagram' },
  { href: 'https://t.me/tigerrising', label: 'Telegram', icon: 'telegram' },
  { href: 'mailto:panda@juche.org', label: 'Email', icon: 'email' },
]

const networkLinks = [
  { href: 'https://tiger.juche.org', label: 'Tiger Unity', emoji: '🐅' },
  { href: 'https://1929.world', label: '1929 World', emoji: '📉' },
  { href: '/library', label: 'Library', emoji: '📚' },
  { href: '/briefings', label: 'Briefings', emoji: '📋' },
  { href: '/truth-project', label: 'Truth Project', emoji: '🔍' },
]
---

<footer class="bg-red-950 border-t border-red-800 py-12">
  <div class="container-app">
    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand Column -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <svg class="h-6 w-6 text-red-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          <span class="text-xl font-bold text-red-300">Juche GanG</span>
        </div>
        <p class="text-red-200 mb-4">
          Dedicated to the pursuit of excellence and the cultivation of personal power through discipline, courage, and unwavering commitment.
        </p>
        <div class="flex items-center gap-2 text-red-300">
          <svg class="h-4 w-4 text-red-500" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span>Made with iron will and determination</span>
        </div>
        <p class="mt-3 text-red-300/90 text-sm">
          We honor the sovereignty, dignity, and cultural traditions of all nations — including the DPRK, the Russian Federation, and the People's Republic of China — and commit to language that fosters mutual respect and understanding.
        </p>
      </div>

      <!-- Quick Links Column -->
      <div>
        <h3 class="text-lg font-bold text-red-300 mb-4">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-red-200 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect Column -->
      <div>
        <h3 class="text-lg font-bold text-red-300 mb-4">Connect</h3>
        <div class="space-y-3">
          <a href="mailto:panda@juche.org" class="flex items-center gap-2 text-red-200 hover:text-white transition-colors">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span>panda@juche.org</span>
          </a>
          <a href="https://instagram.com/jpandajames39" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-red-200 hover:text-white transition-colors">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            <span>@jpandajames39</span>
          </a>
          <a href="https://t.me/tigerrising" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-red-200 hover:text-white transition-colors">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
            </svg>
            <span>@tigerrising</span>
          </a>
        </div>
        <div class="mt-6">
          <h4 class="text-sm font-semibold text-red-300 mb-2">Follow Our Journey</h4>
          <div class="flex gap-3">
            <a
              href="https://instagram.com/jpandajames39"
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 bg-red-800 hover:bg-red-700 rounded-full flex items-center justify-center transition-colors"
              aria-label="Instagram"
            >
              <svg class="h-4 w-4 text-red-200" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073z"/>
              </svg>
            </a>
            <a
              href="https://t.me/tigerrising"
              target="_blank"
              rel="noopener noreferrer"
              class="w-8 h-8 bg-red-800 hover:bg-red-700 rounded-full flex items-center justify-center transition-colors"
              aria-label="Telegram"
            >
              <svg class="h-4 w-4 text-red-200" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
            </a>
            <a
              href="mailto:panda@juche.org"
              class="w-8 h-8 bg-red-800 hover:bg-red-700 rounded-full flex items-center justify-center transition-colors"
              aria-label="Email"
            >
              <svg class="h-4 w-4 text-red-200" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Network Links -->
    <div class="border-t border-red-800 pt-6 mb-6">
      <div class="text-center">
        <p class="text-xs uppercase tracking-wider text-red-400/60 mb-3">Part of the JPanda Network</p>
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-sm">
          {networkLinks.map(link => (
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="text-yellow-400/80 hover:text-yellow-300 transition-colors flex items-center gap-1"
            >
              <span>{link.emoji}</span> {link.label}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-red-800 pt-8 text-center">
      <p class="text-red-200 mb-2">&copy; {currentYear} Juche GanG. All rights reserved.</p>
      <p class="text-red-300 text-sm mb-2">
        <a href="/content-usage" class="underline hover:text-white">Content Usage & Attribution (CC BY 4.0)</a>
      </p>
      <p class="text-red-300 text-sm opacity-90">
        These pages aim to be factual and respectful across cultures. Differences in views are approached with dignity and care.
      </p>
    </div>
  </div>
</footer>
