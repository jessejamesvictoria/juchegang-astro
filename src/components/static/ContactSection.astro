---
import ContactForm from '../islands/ContactForm'
import SectionEyebrow from './SectionEyebrow.astro'
---

<section id="contact" class="border-b-2 border-[var(--ink)]">
  <div class="container-app">
    <div class="grid lg:grid-cols-2 border-x-2 border-[var(--ink)]">
      <div class="cell border-b-2 lg:border-b-0 lg:border-r-2 border-[var(--ink)] reveal">
        <SectionEyebrow label="Contact" labelKo="연락하기" code="CNT-01" />
        <h2 class="text-section frame-angle mb-6">Connect</h2>

        <dl class="space-y-0 border-2 border-[var(--ink)]">
          <div class="grid grid-cols-[auto_1fr] gap-4 px-4 py-3 border-b-2 border-[var(--ink)]">
            <dt class="font-mono-ui text-[var(--muted)]">Email</dt>
            <dd><a href="mailto:panda@juche.org" class="font-mono-ui text-[0.65rem] text-[var(--ink)] no-underline hover:text-[var(--hazard)]">panda@juche.org</a></dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-4 px-4 py-3 border-b-2 border-[var(--ink)]">
            <dt class="font-mono-ui text-[var(--muted)]">Phone</dt>
            <dd><a href="tel:+12504155678" class="font-mono-ui text-[0.65rem] text-[var(--ink)] no-underline hover:text-[var(--hazard)]">+1 (250) 415-5678</a></dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-4 px-4 py-3 border-b-2 border-[var(--ink)]">
            <dt class="font-mono-ui text-[var(--muted)]">Location</dt>
            <dd class="font-mono-ui text-[0.65rem]">Victoria, BC, Canada</dd>
          </div>
          <div class="grid grid-cols-[auto_1fr] gap-4 px-4 py-3">
            <dt class="font-mono-ui text-[var(--muted)]">Telegram</dt>
            <dd><a href="https://t.me/tigerrising" target="_blank" rel="noopener noreferrer" class="font-mono-ui text-[0.65rem] text-[var(--ink)] no-underline hover:text-[var(--hazard)]">@tigerrising</a></dd>
          </div>
        </dl>
      </div>

      <div class="cell reveal reveal-delay-1">
        <ContactForm client:load />
      </div>
    </div>
  </div>
</section>