---
interface Props {
  currentPath?: string
}

const { currentPath = '/' } = Astro.props

const navItems = [
  { href: '#bridge', label: 'Bridge' },
  { href: '#network', label: 'Network' },
  { href: '#ai', label: 'AI' },
  { href: '#process', label: 'Process' },
  { href: '#contact', label: 'Contact' },
]
---

<header class="fixed top-0 left-0 right-0 z-50 border-b-2 border-[var(--ink)] bg-[var(--paper)]">
  <div class="container-app">
    <div class="flex items-stretch justify-between min-h-[var(--nav-h)]">
      <a href="/" class="flex items-center gap-3 no-underline text-inherit py-3 pr-4 border-r border-[var(--ink)] border-opacity-20">
        <img src="/brand/mark.svg" alt="" width="32" height="32" />
        <span class="font-macro text-sm hidden sm:inline">JucheGang</span>
      </a>

      <nav class="hidden lg:flex items-stretch flex-1 justify-end" aria-label="Main navigation">
        {navItems.map((item, i) => (
          <a
            href={item.href}
            class:list={[
              'font-mono-ui flex items-center px-5 no-underline border-l border-[var(--ink)] border-opacity-20 transition-colors',
              currentPath === item.href ? 'bg-[var(--ink)] text-[var(--paper)]' : 'text-[var(--muted)] hover:text-[var(--ink)] hover:bg-[var(--paper)]',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a href="#contact" class="font-mono-ui flex items-center px-6 bg-[var(--hazard)] text-[var(--paper)] no-underline hover:bg-[var(--ink)] transition-colors">
          Connect
        </a>
      </nav>

      <details class="mobile-menu lg:hidden flex items-center">
        <summary class="font-mono-ui px-5 py-4 cursor-pointer" aria-label="Open menu">Menu</summary>
        <nav class="p-0">
          <div class="flex items-center justify-between px-6 py-4 border-b-2 border-[var(--ink)]">
            <span class="font-macro text-sm">Navigation</span>
            <button type="button" onclick="this.closest('details').removeAttribute('open')" class="font-mono-ui cursor-pointer bg-transparent border-0 p-2" aria-label="Close menu">Close</button>
          </div>
          <ul class="divide-y divide-[var(--ink)] divide-opacity-20">
            {navItems.map(item => (
              <li>
                <a href={item.href} class="block font-mono-ui px-6 py-4 no-underline text-[var(--ink)] hover:bg-[var(--hazard)] hover:text-[var(--paper)] transition-colors">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="p-6 border-t-2 border-[var(--ink)]">
            <a href="#contact" class="btn-primary w-full text-center">Connect</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<div class="h-[var(--nav-h)]" aria-hidden="true"></div>