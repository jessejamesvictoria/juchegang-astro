---
import ScrollSpy from '../islands/ScrollSpy'
import { navItems } from '../../data/navigation'
---

<header class="fixed top-0 left-0 right-0 z-[var(--z-nav)] border-b-2 border-[var(--ink)] bg-[var(--paper)]">
  <div class="barcode-strip" aria-hidden="true"></div>
  <div class="container-app">
    <div class="flex items-stretch justify-between min-h-[var(--nav-h)] border-x-2 border-[var(--ink)]">
      <a href="/" class="flex items-center gap-3 no-underline text-inherit py-3 px-4 border-r-2 border-[var(--ink)] group" aria-label="JucheGang home">
        <img src="/brand/mark.svg" alt="" width="32" height="32" aria-hidden="true" class="transition-transform duration-500" style="transition-timing-function: var(--ease-premium)" />
        <span class="font-macro text-sm hidden sm:inline">JucheGang</span>
        <span class="structural-mark hidden md:inline" aria-hidden="true">®</span>
      </a>

      <nav class="hidden lg:flex items-stretch flex-1 justify-end" aria-label="Main navigation">
        {navItems.map(item => (
          <a
            href={item.href}
            data-nav-section={item.section}
            class="nav-link font-mono-ui flex items-center px-5 no-underline border-l-2 border-[var(--ink)] text-[var(--muted)] hover:text-[var(--ink)] hover:bg-[var(--paper)]"
          >
            {item.label}
          </a>
        ))}
        <a href="#contact" class="btn-group border-l-2 border-[var(--ink)]">
          <span class="font-mono-ui flex items-center px-5 bg-[var(--hazard)] text-[var(--paper)]">Connect</span>
          <span class="btn-icon-box bg-[var(--hazard)] text-[var(--paper)] border-l-[var(--ink)]" aria-hidden="true">&gt;&gt;&gt;</span>
        </a>
      </nav>

      <details class="mobile-menu lg:hidden flex items-center border-l-2 border-[var(--ink)]">
        <summary class="font-mono-ui px-5 py-4 cursor-pointer" aria-label="Open menu">Menu</summary>
        <nav class="p-0">
          <div class="flex items-center justify-between px-6 py-4 border-b-2 border-[var(--ink)]">
            <span class="font-macro text-sm">Navigation</span>
            <button type="button" onclick="this.closest('details').removeAttribute('open')" class="font-mono-ui cursor-pointer bg-transparent border-0 p-2" aria-label="Close menu">Close</button>
          </div>
          <ul class="divide-y-2 divide-[var(--ink)]">
            {navItems.map(item => (
              <li>
                <a
                  href={item.href}
                  data-nav-section={item.section}
                  class="block font-mono-ui px-6 py-4 no-underline text-[var(--ink)] hover:bg-[var(--hazard)] hover:text-[var(--paper)]"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
          <div class="p-6 border-t-2 border-[var(--ink)]">
            <a href="#contact" class="btn-group w-full">
              <span class="btn-primary flex-1 text-center border-0">Connect</span>
              <span class="btn-icon-box" aria-hidden="true">&gt;&gt;&gt;</span>
            </a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<ScrollSpy client:idle />

<div class="h-[var(--header-h)]" aria-hidden="true"></div>