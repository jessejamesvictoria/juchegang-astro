---
import type { CurrentPanel } from '../../data/current'

interface Props {
  panel: CurrentPanel
  panelIndex: number
  isLast: boolean
}

const { panel, panelIndex, isLast } = Astro.props
---

<article
  id={panel.id}
  class:list={[
    'border-b border-[var(--rule)]',
    isLast && 'border-b-0',
  ]}
>
  <div class="compartment-header">
    <samp class="font-mono-ui text-[var(--hazard)]">
      {panel.roman} · {panel.hanja} · {panel.titleKo}
    </samp>
  </div>

  <div class="current-panel-body grid lg:grid-cols-2 xl:grid-cols-12 border-b border-[var(--rule)]">
    <div class:list={[
      'current-panel-intro cell min-w-0 border-b lg:border-b-0 lg:border-r border-[var(--rule)] reveal',
      'lg:col-span-1 xl:col-span-4',
      panelIndex % 2 === 1 && 'lg:order-2 xl:order-2 lg:border-r-0 lg:border-l xl:border-l xl:border-r-0',
    ]}>
      <h3 class="current-panel-title text-section frame-bracket text-balance">{panel.title}</h3>
      <p class="font-ko text-sm text-[var(--muted)] mt-2">{panel.titleKo}</p>
      <p class="text-sm text-body text-pretty mt-6 font-medium">{panel.lead}</p>
      <p class="font-ko text-xs text-[var(--muted)] mt-2 text-pretty">{panel.leadKo}</p>
    </div>

    <div class:list={[
      'current-panel-copy cell min-w-0 reveal reveal-delay-1',
      'lg:col-span-1 xl:col-span-8',
      panelIndex % 2 === 1 && 'lg:order-1 xl:order-1',
    ]}>
      <p class="text-sm text-body bilingual text-pretty max-w-none">
        {panel.body}
        <span class="ko block">{panel.bodyKo}</span>
      </p>
      {panel.quote && (
        <blockquote class="current-panel-quote mt-6 border-l-4 border-[var(--hazard)] pl-4">
          <p class="text-xs italic text-pretty">"{panel.quote.text}"</p>
          <cite class="font-mono-ui text-[0.55rem] text-[var(--muted)] block mt-2 not-italic text-pretty">
            {panel.quote.attribution}
          </cite>
        </blockquote>
      )}
    </div>
  </div>

  <div class="current-stats-grid blueprint-grid grid-cols-2 lg:grid-cols-4 reveal reveal-delay-2">
    {panel.stats.map(stat => (
      <div class="current-stat-cell cell min-w-0">
        <data value={stat.value} class="current-stat-value">{stat.value}</data>
        <p class="current-stat-label font-mono-ui">{stat.label}</p>
        {stat.detail && <p class="current-stat-detail text-xs text-[var(--muted)]">{stat.detail}</p>}
      </div>
    ))}
  </div>
</article>