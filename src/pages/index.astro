---
import Base from '../layouts/Base.astro'
import Header from '../components/static/Header.astro'
import Footer from '../components/static/Footer.astro'
import HeroSection from '../components/static/HeroSection.astro'
import BridgeSection from '../components/static/BridgeSection.astro'
import NetworkSection from '../components/static/NetworkSection.astro'
import AISection from '../components/static/AISection.astro'
import ProcessSection from '../components/static/ProcessSection.astro'
import ContactSection from '../components/static/ContactSection.astro'
import PeaceCounter from '../components/islands/PeaceCounter'
---

<Base title="Unity and AI for Korea and Canada">
  <a href="#main-content" class="sr-only">Skip to content</a>
  <Header currentPath="/" />

  <main id="main-content">
    <HeroSection />
    <PeaceCounter client:idle />
    <BridgeSection />
    <NetworkSection />
    <AISection />
    <ProcessSection />
    <ContactSection />
  </main>

  <Footer />
</Base>